# Environment Variables Template
# Copy this to .env and fill in your values
# .env is loaded automatically on startup -- no need to `source` it.
# Do not set ENVIRONMENT=production here; that is set by the deployment
# pipeline only and triggers AWS Secrets Manager loading.
# Database Configuration

GOOGLE_CLIENT_ID= INSERT-GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=INSERT-GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=INSERT-GOOGLE_REDIRECT_URI.

DATABASE_URL= INSERT-DATABASE-URL. 

# Server Configuration
DEBUG=INSERT-DEBUG-VALUE
SECRET_KEY=INSERT-SECRET_KEY

# CORS Configuration
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# JWT Configuration
ALGORITHM= INSERT-ALGORITHM
ACCESS_TOKEN_EXPIRE_MINUTES=INSERT-EXPIRE-TIME

NEXT_PUBLIC_API_URL=INSERT-NEXT_PUBLIC_API_URL

# Frontend URL
FRONTEND_URL=INSERT-FRONTEND_URL